ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://kugni:CHANGE_ME@127.0.0.1:5432/kugni
SITE_URL=https://www.kugni.com
BROWSER_ORIGIN=http://127.0.0.1:3001
WEB_INTERNAL_URL=http://127.0.0.1:3001
SECRET_KEY=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
ENCRYPTION_KEY=GENERATE_A_FERNET_KEY
REVALIDATE_SECRET=SAME_RANDOM_SECRET_AS_WEB
BOOTSTRAP_EMAIL=admin@kugni.com
BOOTSTRAP_PASSWORD=SET_A_RANDOM_PASSWORD
COOKIE_SECURE=false
ALLOW_PRIVATE_TARGETS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Background only; English pages never invoke a translation service on request.
TRANSLATION_ENABLED=true

# Optional, explicitly configured egress for console metadata collection only.
# Direct requests remain the default. Credentials always stay in the encrypted DB.
STATION_SOURCE_PROXY_URL=
# Optional trusted resolver for the explicit proxy mode. Addresses remain pinned.
# Supported: https://cloudflare-dns.com/dns-query or https://dns.google/resolve
STATION_SOURCE_DNS_URL=

# Absolute local path, or /srv/storage/geoip/GeoLite2-City.mmdb in Docker.
GEOIP_DATABASE=
