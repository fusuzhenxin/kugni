{
  "name": "kugni-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebuild": "node ../scripts/build-platform-styles.cjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "start": "node ../scripts/start-web.cjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts",
    "format:check": "prettier --check src tests *.ts"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
